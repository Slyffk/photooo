# ==========================================
# SMART PHOTO BOOTH KIOSK CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=production

# JWT Authentication Secret for Admin Dashboard
JWT_SECRET=haru-photobooth-secure-jwt-key-2026

# Optional Custom Base URL (if using cloud tunnel/domain for mobile QR downloads)
# If empty, automatically uses local Wi-Fi LAN IP (e.g. http://192.168.1.50:5000)
CUSTOM_BASE_URL=

# Default Windows Printer Name
# (e.g. Microsoft Print to PDF, DNP DS620, Citizen CY-02, HiTi P525L)
DEFAULT_PRINTER=Microsoft Print to PDF

# Default Paper Size (4x6, 2x6, A4)
DEFAULT_PAPER_SIZE=4x6

# Photo Retention Policy in Days (auto-cleanup old sessions)
RETENTION_DAYS=7

# QR Code Download Expiration Hours
QR_EXPIRATION_HOURS=24
